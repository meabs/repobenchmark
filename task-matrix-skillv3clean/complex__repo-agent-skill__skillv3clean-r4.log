+@router.post("/{id}/archive", response_model=ItemPublic)
+def archive_item(session: SessionDep, current_user: CurrentUser, id: uuid.UUID) -> Any:
+    """Archive an item."""
+    item = session.get(Item, id)
+    if not item:
+        raise HTTPException(status_code=404, detail="Item not found")
+    if not current_user.is_superuser and (item.owner_id != current_user.id):
+        raise HTTPException(status_code=403, detail="Not enough permissions")
+    item.is_archived = True
+    session.add(item)
+    session.commit()
+    session.refresh(item)
+    return item
+
+
+@router.post("/{id}/unarchive", response_model=ItemPublic)
+def unarchive_item(session: SessionDep, current_user: CurrentUser, id: uuid.UUID) -> Any:
+    """Unarchive an item."""
+    item = session.get(Item, id)
+    if not item:
+        raise HTTPException(status_code=404, detail="Item not found")
+    if not current_user.is_superuser and (item.owner_id != current_user.id):
+        raise HTTPException(status_code=403, detail="Not enough permissions")
+    item.is_archived = False
+    session.add(item)
+    session.commit()
+    session.refresh(item)
+    return item
+
+
