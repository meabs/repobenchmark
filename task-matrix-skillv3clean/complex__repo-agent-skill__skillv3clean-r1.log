+def test_archive_and_unarchive_item(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert response.json()["is_archived"] is True
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/", headers=superuser_token_headers
+    )
+    assert response.status_code == 200
+    assert str(item.id) not in {entry["id"] for entry in response.json()["data"]}
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/?include_archived=true",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert str(item.id) in {entry["id"] for entry in response.json()["data"]}
+
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/unarchive",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert response.json()["is_archived"] is False
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/?include_archived=true",
+        headers=superuser_token_headers,
+    )
+    assert str(item.id) in {entry["id"] for entry in response.json()["data"]}
+
+
+def test_archive_item_not_enough_permissions(
