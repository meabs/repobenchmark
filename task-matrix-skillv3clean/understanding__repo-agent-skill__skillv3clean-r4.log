   105	    *, session: SessionDep, body: UpdatePassword, current_user: CurrentUser
   106	) -> Any:
   107	    """
   108	    Update own password.
   109	    """
   110	    verified, _ = verify_password(body.current_password, current_user.hashed_password)
   111	    if not verified:
