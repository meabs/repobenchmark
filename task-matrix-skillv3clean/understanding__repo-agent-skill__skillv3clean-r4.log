    63	def create_item(*, session: Session, item_in: ItemCreate, owner_id: uuid.UUID) -> Item:
    64	    db_item = Item.model_validate(item_in, update={"owner_id": owner_id})
    65	    session.add(db_item)
    66	    session.commit()
    67	    session.refresh(db_item)
    68	    return db_item

