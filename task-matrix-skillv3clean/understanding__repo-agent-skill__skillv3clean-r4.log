   255	        headers=superuser_token_headers,
   256	        json=old_data,
   257	    )
   258	    db.refresh(user_db)
   259	
   260	    assert r.status_code == 200
   261	    verified, _ = verify_password(
   262	        settings.FIRST_SUPERUSER_PASSWORD, user_db.hashed_password
   263	    )
