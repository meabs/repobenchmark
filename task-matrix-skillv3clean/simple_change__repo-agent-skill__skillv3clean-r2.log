+    )
+    assert response.status_code == 200
+    default_titles = [item["title"] for item in response.json()["data"]]
+    assert default_titles.index("Zebra") < default_titles.index("Apple")
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"order_by": "title"},
+    )
+    assert response.status_code == 200
+    title_order = [item["title"] for item in response.json()["data"]]
