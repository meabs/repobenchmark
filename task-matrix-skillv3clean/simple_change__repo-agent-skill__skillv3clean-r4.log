     assert len(content["data"]) >= 2
 
 
+def test_read_items_ordering(
+    client: TestClient, superuser_token_headers: dict[str, str]
+) -> None:
+    titles = [f"sort-{uuid.uuid4()}-{suffix}" for suffix in ("z", "a", "m")]
+    for title in titles:
+        response = client.post(
+            f"{settings.API_V1_STR}/items/",
+            headers=superuser_token_headers,
+            json={"title": title, "description": title},
+        )
+        assert response.status_code == 200
+
+    default_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    title_response = client.get(
+        f"{settings.API_V1_STR}/items/?order_by=title",
+        headers=superuser_token_headers,
+    )
+
+    assert default_response.status_code == 200
+    assert title_response.status_code == 200
+    default_titles = [
+        item["title"]
+        for item in default_response.json()["data"]
+        if item["title"] in titles
+    ]
+    title_order = [
+        item["title"]
+        for item in title_response.json()["data"]
+        if item["title"] in titles
+    ]
+    assert default_titles == list(reversed(titles))
+    assert title_order == sorted(titles)
+
+
