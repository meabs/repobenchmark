+    )
+    assert archive_response.status_code == 200
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert str(item.id) not in {listed_item["id"] for listed_item in response.json()["data"]}
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"include_archived": True},
+    )
+    assert response.status_code == 200
+    archived_item = next(
+        listed_item
+        for listed_item in response.json()["data"]
+        if listed_item["id"] == str(item.id)
+    )
+    assert archived_item["is_archived"] is True
