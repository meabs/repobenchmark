def test_read_items(
    client: TestClient, superuser_token_headers: dict[str, str], db: Session
) -> None:
    first_item = create_random_item(db)
    first_item.title = "aaa-ordering-test"
    second_item = create_random_item(db)
    second_item.title = "zzz-ordering-test"
    db.add(first_item)
    db.add(second_item)
    db.commit()
    response = client.get(
        f"{settings.API_V1_STR}/items/",
        headers=superuser_token_headers,
    )
    assert response.status_code == 200
    content = response.json()
    assert len(content["data"]) >= 2


def test_read_items_ordering(
    client: TestClient, superuser_token_headers: dict[str, str], db: Session
) -> None:
    create_random_item(db)
    create_random_item(db)

    created_at_response = client.get(
        f"{settings.API_V1_STR}/items/",
        headers=superuser_token_headers,
    )
    assert created_at_response.status_code == 200
    created_at_items = created_at_response.json()["data"]
    assert [item["created_at"] for item in created_at_items] == sorted(
        (item["created_at"] for item in created_at_items), reverse=True
    )

    title_response = client.get(
        f"{settings.API_V1_STR}/items/",
        headers=superuser_token_headers,
        params={"order_by": "title"},
    )
    assert title_response.status_code == 200
    title_items = title_response.json()["data"]
    title_positions = {item["title"]: index for index, item in enumerate(title_items)}
    assert title_positions["aaa-ordering-test"] < title_positions["zzz-ordering-test"]


def test_update_item(
    client: TestClient, superuser_token_headers: dict[str, str], db: Session
) -> None:
    item = create_random_item(db)
    data = {"title": "Updated title", "description": "Updated description"}
    response = client.put(
        f"{settings.API_V1_STR}/items/{item.id}",
        headers=superuser_token_headers,
        json=data,
    )
    assert response.status_code == 200
    content = response.json()

