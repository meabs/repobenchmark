    38	            .order_by(col(Item.created_at).desc())
    39	            .offset(skip)
    40	            .limit(limit)
    41	        )
    42	        items = session.exec(statement).all()
    43	
    44	    items_public = [ItemPublic.model_validate(item) for item in items]
    45	    return ItemsPublic(data=items_public, count=count)
