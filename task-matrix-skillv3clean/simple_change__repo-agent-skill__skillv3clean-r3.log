+def test_read_items_order_by(
+    client: TestClient, normal_user_token_headers: dict[str, str]
+) -> None:
+    for title in ("Zebra", "Alpha"):
+        response = client.post(
+            f"{settings.API_V1_STR}/items/",
+            headers=normal_user_token_headers,
+            json={"title": title, "description": title},
+        )
+        assert response.status_code == 200
+
+    default_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=normal_user_token_headers,
+    )
+    title_response = client.get(
+        f"{settings.API_V1_STR}/items/?order_by=title",
+        headers=normal_user_token_headers,
+    )
+
+    assert default_response.status_code == 200
+    assert title_response.status_code == 200
+    assert [item["title"] for item in default_response.json()["data"]] == [
+        "Alpha",
+        "Zebra",
+    ]
+    assert [item["title"] for item in title_response.json()["data"]] == [
+        "Alpha",
+        "Zebra",
+    ]
+
+
