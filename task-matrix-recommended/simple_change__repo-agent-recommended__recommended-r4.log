+    newer_item = create_random_item(db)
+    older_item.title = "alpha-ordering-test"
+    newer_item.title = "zulu-ordering-test"
+    newer_item.created_at = datetime.now(UTC)
+    older_item.created_at = newer_item.created_at - timedelta(minutes=1)
+    db.add_all([older_item, newer_item])
+    db.commit()
+
+    default_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert default_response.status_code == 200
+    default_ids = [item["id"] for item in default_response.json()["data"]]
+    assert default_ids.index(str(newer_item.id)) < default_ids.index(str(older_item.id))
+
+    title_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"order_by": "title"},
+    )
+    assert title_response.status_code == 200
+    title_ids = [item["id"] for item in title_response.json()["data"]]
+    assert title_ids.index(str(older_item.id)) < title_ids.index(str(newer_item.id))
+
+
