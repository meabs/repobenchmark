+      const itemRow = page.getByRole("row").filter({ hasText: itemTitle })
+      await itemRow.getByRole("button").last().click()
+      await page.getByRole("menuitem", { name: "Archive Item" }).click()
+
+      await expect(page.getByText("Item archived successfully")).toBeVisible()
+      await expect(page.getByText(itemTitle)).not.toBeVisible()
+
+      await page.getByRole("checkbox", { name: "Show archived" }).check()
+      const archivedRow = page.getByRole("row").filter({ hasText: itemTitle })
+      await expect(archivedRow.getByText("Archived")).toBeVisible()
+
+      await archivedRow.getByRole("button").last().click()
+      await page.getByRole("menuitem", { name: "Unarchive Item" }).click()
+
+      await expect(page.getByText("Item unarchived successfully")).toBeVisible()
+      await expect(page.getByText(itemTitle)).toBeVisible()
+      await expect(
+        page.getByRole("row").filter({ hasText: itemTitle }).getByText("Archived"),
+      ).not.toBeVisible()
+    })
   })
