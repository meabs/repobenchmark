    13	@router.get("/", response_model=ItemsPublic)
    14	def read_items(
    15	    session: SessionDep, current_user: CurrentUser, skip: int = 0, limit: int = 100
    16	) -> Any:
    17	    """
    18	    Retrieve items.
    19	    """
