@@ -79,6 +79,64 @@
     assert len(content["data"]) >= 2
 
 
+def test_archive_and_unarchive_item(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+
+    archive_response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=superuser_token_headers,
+    )
+    assert archive_response.status_code == 200
+    assert archive_response.json()["is_archived"] is True
+
+    default_response = client.get(
+        f"{settings.API_V1_STR}/items/", headers=superuser_token_headers
+    )
+    assert item.id not in {entry["id"] for entry in default_response.json()["data"]}
+
+    included_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"include_archived": True},
+    )
+    assert str(item.id) in {
+        entry["id"] for entry in included_response.json()["data"]
+    }
+
+    unarchive_response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/unarchive",
+        headers=superuser_token_headers,
+    )
+    assert unarchive_response.status_code == 200
+    assert unarchive_response.json()["is_archived"] is False
+
+
+def test_archive_item_not_enough_permissions(
+    client: TestClient, normal_user_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=normal_user_token_headers,
+    )
+    assert response.status_code == 403
+    assert response.json()["detail"] == "Not enough permissions"
+
+
+def test_unarchive_item_not_enough_permissions(
+    client: TestClient, normal_user_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/unarchive",
+        headers=normal_user_token_headers,
+    )
+    assert response.status_code == 403
+    assert response.json()["detail"] == "Not enough permissions"
+
+
 def test_update_item(
     client: TestClient, superuser_token_headers: dict[str, str], db: Session
 ) -> None:
diff --git a/frontend/src/components/Items/ArchiveItem.tsx b/frontend/src/components/Items/ArchiveItem.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e66cebc63a8c2c5cfdb4732763f8ee18fbd2c558
--- /dev/null
+++ b/frontend/src/components/Items/ArchiveItem.tsx
@@ -0,0 +1,45 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query"
+import { Archive, ArchiveRestore } from "lucide-react"
+
+import { ItemsService } from "@/client"
+import { DropdownMenuItem } from "@/components/ui/dropdown-menu"
+import useCustomToast from "@/hooks/useCustomToast"
+import { handleError } from "@/utils"
+
+interface ArchiveItemProps {
+  id: string
+  isArchived: boolean
+  onSuccess: () => void
+}
+
+const ArchiveItem = ({ id, isArchived, onSuccess }: ArchiveItemProps) => {
+  const queryClient = useQueryClient()
+  const { showSuccessToast, showErrorToast } = useCustomToast()
+
+  const mutation = useMutation({
+    mutationFn: () =>
+      isArchived
+        ? ItemsService.unarchiveItem({ path: { id } })
+        : ItemsService.archiveItem({ path: { id } }),
+    onSuccess: () => {
+      showSuccessToast(isArchived ? "Item unarchived successfully" : "Item archived successfully")
+      onSuccess()
+    },
+    onError: handleError.bind(showErrorToast),
+    onSettled: () => {
+      queryClient.invalidateQueries({ queryKey: ["items"] })
+    },
+  })
+
+  return (
+    <DropdownMenuItem
+      disabled={mutation.isPending}
+      onClick={() => mutation.mutate()}
+    >
+      {isArchived ? <ArchiveRestore /> : <Archive />}
+      {isArchived ? "Unarchive Item" : "Archive Item"}
+    </DropdownMenuItem>
+  )
+}
+
+export default ArchiveItem
