diff --git a/backend/tests/api/routes/test_items.py b/backend/tests/api/routes/test_items.py
index 3e82cd0134757608c8f95e6084d7c967f52230d6..34674cb228bba1cb996ccd6d1ddda8ab4238a99e
--- a/backend/tests/api/routes/test_items.py
+++ b/backend/tests/api/routes/test_items.py
@@ -79,6 +79,36 @@
     assert len(content["data"]) >= 2
 
 
+def test_read_items_ordering(
+    client: TestClient, superuser_token_headers: dict[str, str]
+) -> None:
+    for title in ("zebra", "apple", "mango"):
+        response = client.post(
+            f"{settings.API_V1_STR}/items/",
+            headers=superuser_token_headers,
+            json={"title": title, "description": title},
+        )
+        assert response.status_code == 200
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    created_at_order = [item["created_at"] for item in response.json()["data"]]
+    assert created_at_order == sorted(created_at_order, reverse=True)
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"order_by": "title"},
+    )
+    assert response.status_code == 200
+    title_order = [item["title"] for item in response.json()["data"]]
+    title_positions = [title_order.index(title) for title in ("apple", "mango", "zebra")]
+    assert title_positions == sorted(title_positions)
+
+
