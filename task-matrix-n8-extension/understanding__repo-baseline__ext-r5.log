    61	@router.post("/", response_model=ItemPublic)
    62	def create_item(
    63	    *, session: SessionDep, current_user: CurrentUser, item_in: ItemCreate
    64	) -> Any:
    65	    """
    66	    Create new item.
    67	    """
    68	    item = Item.model_validate(item_in, update={"owner_id": current_user.id})
