+def archive_item(
+    session: SessionDep, current_user: CurrentUser, id: uuid.UUID
+) -> Item:
+    """Archive an item."""
+    return _set_item_archived(
+        session=session, current_user=current_user, id=id, is_archived=True
+    )
+
+
+@router.post("/{id}/unarchive", response_model=ItemPublic)
+def unarchive_item(
