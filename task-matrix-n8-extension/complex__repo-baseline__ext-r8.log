+def test_archive_and_unarchive_item_and_filter_listing(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert response.json()["is_archived"] is True
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert str(item.id) not in {entry["id"] for entry in response.json()["data"]}
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"include_archived": "true"},
+    )
+    assert response.status_code == 200
+    archived = next(
+        entry for entry in response.json()["data"] if entry["id"] == str(item.id)
+    )
+    assert archived["is_archived"] is True
+
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/unarchive",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert response.json()["is_archived"] is False
+
+
+def test_archive_item_not_enough_permissions(
+    client: TestClient, normal_user_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=normal_user_token_headers,
+    )
+    assert response.status_code == 403
+    assert response.json()["detail"] == "Not enough permissions"
+
+
+def test_unarchive_item_not_enough_permissions(
+    client: TestClient, normal_user_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/unarchive",
+        headers=normal_user_token_headers,
+    )
+    assert response.status_code == 403
+    assert response.json()["detail"] == "Not enough permissions"
+
