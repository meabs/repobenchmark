+    assert response.json()["is_archived"] is True
+
+    default_listing = client.get(
+        f"{settings.API_V1_STR}/items/", headers=superuser_token_headers
+    )
+    assert str(item.id) not in {entry["id"] for entry in default_listing.json()["data"]}
+
+    included_listing = client.get(
