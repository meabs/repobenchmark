+def test_read_items_ordering(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    older_item = create_random_item(db)
+    newer_item = create_random_item(db)
+    older_item.title = "z-item"
+    newer_item.title = "a-item"
+    newer_item.created_at = datetime.now(UTC)
+    older_item.created_at = newer_item.created_at - timedelta(days=1)
+    db.add_all([older_item, newer_item])
+    db.commit()
+
+    base_url = f"{settings.API_V1_STR}/items/"
+    title_response = client.get(
+        f"{base_url}?order_by=title",
+        headers=superuser_token_headers,
+    )
+    created_at_response = client.get(
+        f"{base_url}?order_by=created_at",
+        headers=superuser_token_headers,
+    )
+
+    assert title_response.status_code == 200
+    assert created_at_response.status_code == 200
+    title_ids = [item["id"] for item in title_response.json()["data"]]
+    created_at_ids = [item["id"] for item in created_at_response.json()["data"]]
+    assert title_ids.index(str(newer_item.id)) < title_ids.index(str(older_item.id))
+    assert created_at_ids.index(str(newer_item.id)) < created_at_ids.index(
+        str(older_item.id)
+    )
+
