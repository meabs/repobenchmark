+def test_archive_and_unarchive_item(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+
+    archive_response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=superuser_token_headers,
+    )
+    assert archive_response.status_code == 200
+    assert archive_response.json()["is_archived"] is True
+
+    default_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert item.id not in {entry["id"] for entry in default_response.json()["data"]}
+
+    included_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"include_archived": True},
+    )
+    included_item = next(
+        entry for entry in included_response.json()["data"] if entry["id"] == str(item.id)
+    )
+    assert included_item["is_archived"] is True
+
+    unarchive_response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/unarchive",
+        headers=superuser_token_headers,
+    )
+    assert unarchive_response.status_code == 200
+    assert unarchive_response.json()["is_archived"] is False
+
+
+def test_archive_endpoints_not_enough_permissions(
+    client: TestClient, normal_user_token_headers: dict[str, str], db: Session
+) -> None:
