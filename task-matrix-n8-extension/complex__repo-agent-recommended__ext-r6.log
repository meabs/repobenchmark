diff --git a/frontend/src/components/Items/ArchiveItem.tsx b/frontend/src/components/Items/ArchiveItem.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ce81fdc1e4a7c1efa05117020cb5914325550f45
--- /dev/null
+++ b/frontend/src/components/Items/ArchiveItem.tsx
@@ -0,0 +1,45 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query"
+import { Archive, ArchiveRestore } from "lucide-react"
+
+import { type ItemPublic, ItemsService } from "@/client"
+import { DropdownMenuItem } from "@/components/ui/dropdown-menu"
+import useCustomToast from "@/hooks/useCustomToast"
+import { handleError } from "@/utils"
+
+interface ArchiveItemProps {
+  item: ItemPublic
+  onSuccess: () => void
+}
+
+const ArchiveItem = ({ item, onSuccess }: ArchiveItemProps) => {
+  const queryClient = useQueryClient()
+  const { showSuccessToast, showErrorToast } = useCustomToast()
+  const isArchived = item.is_archived
+
+  const mutation = useMutation({
+    mutationFn: () =>
+      isArchived
+        ? ItemsService.unarchiveItem({ path: { id: item.id } })
+        : ItemsService.archiveItem({ path: { id: item.id } }),
+    onSuccess: () => {
+      showSuccessToast(isArchived ? "Item unarchived successfully" : "Item archived successfully")
+      onSuccess()
+    },
+    onError: handleError.bind(showErrorToast),
+    onSettled: () => {
+      queryClient.invalidateQueries({ queryKey: ["items"] })
+    },
+  })
+
+  return (
+    <DropdownMenuItem
+      disabled={mutation.isPending}
+      onClick={() => mutation.mutate()}
+    >
+      {isArchived ? <ArchiveRestore /> : <Archive />}
+      {isArchived ? "Unarchive Item" : "Archive Item"}
+    </DropdownMenuItem>
+  )
+}
+
+export default ArchiveItem
