+    assert default_response.status_code == 200
+    title_items = title_response.json()["data"]
+    default_items = default_response.json()["data"]
+    title_ids = [item["id"] for item in title_items]
+    default_ids = [item["id"] for item in default_items]
+    assert title_ids.index(older_item.json()["id"]) < title_ids.index(
+        newer_item.json()["id"]
+    )
+    assert default_ids.index(newer_item.json()["id"]) < default_ids.index(
+        older_item.json()["id"]
+    )
