    79	    """
    80	    Reset password
    81	    """
    82	    email = verify_password_reset_token(token=body.token)
    83	    if not email:
    84	        raise HTTPException(status_code=400, detail="Invalid token")
    85	    user = crud.get_user_by_email(session=session, email=email)
    86	    if not user:
