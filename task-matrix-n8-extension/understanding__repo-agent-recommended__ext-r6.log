   245	    verified, _ = verify_password(new_password, user_db.hashed_password)
   246	    assert verified
   247	
   248	    # Revert to the old password to keep consistency in test
   249	    old_data = {
   250	        "current_password": new_password,
   251	        "new_password": settings.FIRST_SUPERUSER_PASSWORD,
   252	    }
   253	    r = client.patch(
   254	        f"{settings.API_V1_STR}/users/me/password",
   255	        headers=superuser_token_headers,
   256	        json=old_data,
   257	    )
   258	    db.refresh(user_db)
   259	
   260	    assert r.status_code == 200
   261	    verified, _ = verify_password(
   262	        settings.FIRST_SUPERUSER_PASSWORD, user_db.hashed_password
   263	    )
   264	    assert verified
