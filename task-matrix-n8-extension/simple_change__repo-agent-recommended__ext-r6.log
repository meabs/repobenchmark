+    newer_item.title = "A sorting item"
+    older_item.created_at = datetime(2020, 1, 1, tzinfo=UTC)
+    newer_item.created_at = datetime(2021, 1, 1, tzinfo=UTC)
+    db.add_all([older_item, newer_item])
