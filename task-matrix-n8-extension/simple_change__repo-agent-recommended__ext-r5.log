--- a/backend/tests/api/routes/test_items.py
+++ b/backend/tests/api/routes/test_items.py
@@ -1,4 +1,5 @@
 import uuid
+from datetime import UTC, datetime
 
 from fastapi.testclient import TestClient
 from sqlmodel import Session
@@ -79,6 +80,36 @@
     assert len(content["data"]) >= 2
 
 
+def test_read_items_order_by(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    older_item = create_random_item(db)
+    older_item.title = "alpha"
+    older_item.created_at = datetime(2024, 1, 1, tzinfo=UTC)
+    newer_item = create_random_item(db)
+    newer_item.title = "zulu"
+    newer_item.created_at = datetime(2024, 1, 2, tzinfo=UTC)
+    db.add_all([older_item, newer_item])
+    db.commit()
+
+    default_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert default_response.status_code == 200
+    default_titles = [item["title"] for item in default_response.json()["data"]]
+    assert default_titles.index("zulu") < default_titles.index("alpha")
+
+    title_response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"order_by": "title"},
+    )
+    assert title_response.status_code == 200
+    title_titles = [item["title"] for item in title_response.json()["data"]]
+    assert title_titles.index("alpha") < title_titles.index("zulu")
+
+
