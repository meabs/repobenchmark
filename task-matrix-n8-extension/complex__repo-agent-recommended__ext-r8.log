+  })
+
+  return (
+    <DropdownMenuItem
+      disabled={mutation.isPending}
+      onSelect={(event) => {
+        event.preventDefault()
+        mutation.mutate()
+      }}
+    >
+      {item.is_archived ? <ArchiveRestore /> : <Archive />}
