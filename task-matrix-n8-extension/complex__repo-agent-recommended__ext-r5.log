+      await expect(archivedRow.getByText("Archived")).toBeVisible()
+
+      await archivedRow.getByRole("button").last().click()
+      await page.getByRole("menuitem", { name: "Unarchive Item" }).click()
+
+      await expect(page.getByText("Item unarchived successfully")).toBeVisible()
+      await expect(archivedRow.getByText("Archived")).not.toBeVisible()
+    })
   })
