+def _get_owned_item(
+    session: SessionDep, current_user: CurrentUser, id: uuid.UUID
+) -> Item:
+    item = session.get(Item, id)
+    if not item:
+        raise HTTPException(status_code=404, detail="Item not found")
+    if not current_user.is_superuser and item.owner_id != current_user.id:
+        raise HTTPException(status_code=403, detail="Not enough permissions")
+    return item
+
+
+def _set_item_archived(
+    session: SessionDep, current_user: CurrentUser, id: uuid.UUID, is_archived: bool
+) -> Item:
+    item = _get_owned_item(session, current_user, id)
+    item.is_archived = is_archived
+    session.add(item)
+    session.commit()
+    session.refresh(item)
+    return item
+
+
+@router.post("/{id}/archive", response_model=ItemPublic)
+def archive_item(
+    session: SessionDep, current_user: CurrentUser, id: uuid.UUID
+) -> Any:
+    """Archive an item."""
+    return _set_item_archived(session, current_user, id, True)
+
+
+@router.post("/{id}/unarchive", response_model=ItemPublic)
+def unarchive_item(
+    session: SessionDep, current_user: CurrentUser, id: uuid.UUID
+) -> Any:
+    """Unarchive an item."""
+    return _set_item_archived(session, current_user, id, False)
