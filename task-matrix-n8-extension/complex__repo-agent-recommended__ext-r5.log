+def test_archive_item_and_filter_items(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    item = create_random_item(db)
+    response = client.post(
+        f"{settings.API_V1_STR}/items/{item.id}/archive",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert response.json()["is_archived"] is True
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    assert str(item.id) not in {
+        listed_item["id"] for listed_item in response.json()["data"]
+    }
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"include_archived": True},
+    )
+    assert response.status_code == 200
+    assert str(item.id) in {listed_item["id"] for listed_item in response.json()["data"]}
+
+
