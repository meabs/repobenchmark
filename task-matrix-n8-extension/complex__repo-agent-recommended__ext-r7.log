+    assert str(active_item.id) in default_ids
+    assert str(archived_item.id) not in default_ids
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+        params={"include_archived": "true"},
