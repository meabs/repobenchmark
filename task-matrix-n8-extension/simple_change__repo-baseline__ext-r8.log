+) -> None:
+    item_ids = []
+    for title in ["sort-a", "sort-z"]:
+        response = client.post(
+            f"{settings.API_V1_STR}/items/",
+            headers=superuser_token_headers,
+            json={"title": title, "description": "sorting test"},
+        )
+        assert response.status_code == 200
+        item_ids.append(response.json()["id"])
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    created_at_titles = [
+        item["title"] for item in response.json()["data"] if item["id"] in item_ids
+    ]
+    assert created_at_titles == ["sort-z", "sort-a"]
+
+    response = client.get(
+        f"{settings.API_V1_STR}/items/?order_by=title",
+        headers=superuser_token_headers,
+    )
+    assert response.status_code == 200
+    title_ordered_titles = [
+        item["title"] for item in response.json()["data"] if item["id"] in item_ids
+    ]
+    assert title_ordered_titles == ["sort-a", "sort-z"]
+
